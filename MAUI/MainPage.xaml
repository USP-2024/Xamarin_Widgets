<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WidgetDemoApp.MainPage"
             Title="Widget Demo App"
             BackgroundColor="#F4F6F8">

    <!-- ScrollView wraps everything so the page scrolls on small screens -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Image: circular profile picture (Frame clips the image into a circle) -->
            <Frame HeightRequest="120" WidthRequest="120" CornerRadius="60"
                   Padding="0" IsClippedToBounds="True" HasShadow="True"
                   HorizontalOptions="Center">
                <Image Source="avatar.png" Aspect="AspectFill" />
            </Frame>

            <!-- Frame: card containing two Labels (name and course) -->
            <Frame CornerRadius="16" HasShadow="True" Padding="16" BackgroundColor="White">
                <StackLayout Spacing="4">
                    <Label Text="Ananya Sharma" FontSize="24" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" TextColor="#16201B" />
                    <Label Text="B.Tech Computer Science - 6th Semester" FontSize="14"
                           HorizontalTextAlignment="Center" TextColor="Gray" />
                </StackLayout>
            </Frame>

            <!-- Grid: rows and columns for the statistics -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="12" FontSize="22" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Grid.Column="0" Text="Projects" FontSize="12" TextColor="Gray"
                       HorizontalTextAlignment="Center" />

                <Label Grid.Row="0" Grid.Column="1" Text="8.6" FontSize="22" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Grid.Column="1" Text="CGPA" FontSize="12" TextColor="Gray"
                       HorizontalTextAlignment="Center" />

                <Label Grid.Row="0" Grid.Column="2" Text="3" FontSize="22" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Grid.Column="2" Text="Awards" FontSize="12" TextColor="Gray"
                       HorizontalTextAlignment="Center" />
            </Grid>

            <!-- Grid: two equal-width Buttons side by side -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button x:Name="LikeButton" Grid.Column="0" Text="Like (0)" Clicked="OnLikeClicked"
                        BackgroundColor="#1F9D6B" TextColor="White" CornerRadius="10" />
                <Button Grid.Column="1" Text="Message" Clicked="OnMessageClicked"
                        BackgroundColor="#16201B" TextColor="White" CornerRadius="10" />
            </Grid>

            <!-- Entry: single-line text input -->
            <Entry x:Name="CommentEntry" Placeholder="Add a comment" ReturnType="Done"
                   Completed="OnCommentCompleted" />
            <Label x:Name="CommentLabel" Text="" TextColor="#0D47A1" />

            <!-- Switch: on/off toggle, laid out with a Grid -->
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="AvailabilityLabel" Grid.Column="0" Text="Available for projects"
                       VerticalOptions="Center" FontSize="16" />
                <Switch Grid.Column="1" IsToggled="True" Toggled="OnAvailableToggled" />
            </Grid>

            <!-- CollectionView: horizontally scrolling list of skill tags -->
            <Label Text="Skills" FontSize="18" FontAttributes="Bold" />
            <CollectionView x:Name="SkillsView" HeightRequest="60" ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="20" Padding="14,8" Margin="0,0,10,0"
                               HasShadow="False" BackgroundColor="#E3F2FD"
                               VerticalOptions="Center">
                            <Label Text="{Binding .}" TextColor="#0D47A1" FontAttributes="Bold" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
